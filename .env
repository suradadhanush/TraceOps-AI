# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://eas_user:eas_pass@localhost:5432/eas_db
SYNC_DATABASE_URL=postgresql://eas_user:eas_pass@localhost:5432/eas_db

# ─── Redis / Celery ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── AI Providers ────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── LLM Analyzer preference: "openai" | "anthropic" ────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# ─── Loop Detection ──────────────────────────────────────
EMBEDDING_SIMILARITY_THRESHOLD=0.85
LOOP_MIN_OCCURRENCES=3

# ─── Scoring ─────────────────────────────────────────────
VELOCITY_FAST_THRESHOLD_HOURS=3
VELOCITY_MED_THRESHOLD_HOURS=6

# ─── App ─────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

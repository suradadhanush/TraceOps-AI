# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://traceops_user:traceops_pass@localhost:5432/traceops_db
SYNC_DATABASE_URL=postgresql://traceops_user:traceops_pass@localhost:5432/traceops_db

# ── Redis / Celery ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── AI Providers ──────────────────────────────────────────
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder

# ── LLM ──────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ── App ───────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
LOG_LEVEL=INFO

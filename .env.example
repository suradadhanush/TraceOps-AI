# ── Database (Neon) ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?ssl=require
SYNC_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:YOUR_TOKEN@firm-skylark-93912.upstash.io:6379
CELERY_BROKER_URL=rediss://default:YOUR_TOKEN@firm-skylark-93912.upstash.io:6379?ssl_cert_reqs=CERT_NONE
CELERY_RESULT_BACKEND=rediss://default:YOUR_TOKEN@firm-skylark-93912.upstash.io:6379?ssl_cert_reqs=CERT_NONE

# ── OAuth — GitHub ────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers -> OAuth Apps -> New
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── OAuth — Google ────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com -> APIs -> Credentials -> OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Frontend URL (used for OAuth redirect URIs) ───────────────────────────────
FRONTEND_URL=https://traceops-ai.onrender.com

# ── AI Providers (optional — for LLM report analysis) ─────────────────────────
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=generate-with-python-secrets-token-hex-32
LOG_LEVEL=INFO
PYTHON_VERSION=3.11.9
SESSION_EXPIRE_DAYS=30
